# Kopiere diese Datei nach ".env" und passe die Werte an.

# Port, auf dem der Server lauscht (im Container und auf dem Host).
PORT=3000

# PIN für die Spielleitung (/host). PFLICHT im Docker-Betrieb.
# Wähle etwas, das Schüler nicht erraten (mind. 6 Zeichen).
HOST_PIN=bitte-aendern

# Öffentliche Adresse für QR-Code und Beitrittslink, ohne abschließenden Schrägstrich,
# z. B. die Domain des Cloudflare Tunnels. Leer = wird aus der Anfrage abgeleitet.
PUBLIC_URL=https://wortschwindel.example.org

# true = Räume werden laufend in data/state.json gesichert und nach einem
# Neustart des Containers wiederhergestellt.
PERSIST=true

# Räume ohne Aktivität werden nach so vielen Stunden gelöscht.
ROOM_TTL_HOURS=3

# Nur für Tests: sehr kurze Timer (15 s Schreiben, 10 s Abstimmen).
# DEV_SHORT_TIMERS=true

# Optional: Token für den cloudflared-Container (siehe docker-compose.yml).
# CLOUDFLARE_TUNNEL_TOKEN=
